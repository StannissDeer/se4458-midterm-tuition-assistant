{
  "name": "search_tuition_policies",
  "description": "Full-text search over the indexed University Tuition Policies document (deadlines, installments, late fees, scholarships, refunds, banking instructions). Returns the most relevant passages with section ID, heading, document ID and text. This is policy text only - it does NOT contain any student's balance or records.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "query": {
        "title": "Query",
        "type": "string"
      },
      "top_k": {
        "default": 4,
        "title": "Top K",
        "type": "integer"
      }
    },
    "required": [
      "query"
    ],
    "title": "search_tuition_policiesArguments"
  },
  "outputSchema": {
    "$defs": {
      "PolicyMatch": {
        "properties": {
          "section": {
            "description": "Section ID to cite, e.g. '3.2'",
            "title": "Section",
            "type": "string"
          },
          "heading": {
            "description": "Section heading, e.g. 'Number and size of installments'",
            "title": "Heading",
            "type": "string"
          },
          "parentSection": {
            "description": "Top-level section, e.g. '3. Installment policy'",
            "title": "Parentsection",
            "type": "string"
          },
          "score": {
            "description": "BM25 relevance score",
            "title": "Score",
            "type": "number"
          },
          "text": {
            "description": "Policy text of the section",
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "section",
          "heading",
          "parentSection",
          "score",
          "text"
        ],
        "title": "PolicyMatch",
        "type": "object"
      }
    },
    "description": "Shape follows Section 9 of the policy document: document, document ID and matches.",
    "properties": {
      "document": {
        "default": "University_Tuition_Policies.md",
        "title": "Document",
        "type": "string"
      },
      "documentId": {
        "default": "",
        "description": "e.g. UNI-TUITION-2026-01",
        "title": "Documentid",
        "type": "string"
      },
      "query": {
        "title": "Query",
        "type": "string"
      },
      "matches": {
        "items": {
          "$ref": "#/$defs/PolicyMatch"
        },
        "title": "Matches",
        "type": "array"
      },
      "message": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Message"
      }
    },
    "required": [
      "query",
      "matches"
    ],
    "title": "PolicySearchResult",
    "type": "object"
  }
}